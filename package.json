{
  "name": "maxify-support",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source-grounded customer support agent with tool use, OpenTelemetry tracing, and a Python evaluation harness.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node build/src/server.js",
    "start:dev": "tsx src/server.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:python": "PYTHONPATH=evals python3 -m unittest discover -s evals/tests -v",
    "test:integration": "INTEGRATION=1 tsx --test tests/integration.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:python && npm run build",
    "ingest": "tsx scripts/ingest.ts",
    "seed": "tsx scripts/seed.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "smoke": "tsx scripts/smoke.ts",
    "reliability": "tsx scripts/reliability.ts",
    "eval": "make eval",
    "eval:py": "PYTHONPATH=evals python3 -m maxify_evals",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.57.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.57.2",
    "@opentelemetry/exporter-prometheus": "0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-metrics": "1.30.1",
    "@opentelemetry/sdk-node": "0.57.2",
    "@opentelemetry/semantic-conventions": "1.30.0",
    "cheerio": "1.2.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "openai": "4.104.0",
    "pg": "8.23.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.0",
    "vite": "7.1.0"
  }
}
