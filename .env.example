# Native local setup. Copy to .env and supply your own provider key.
OPENAI_API_KEY=replace-with-your-provider-key
LITELLM_API_KEY=replace-with-a-local-gateway-key
APP_DATABASE_URL=postgres://support:support@127.0.0.1:5433/support
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
APP_HOST=127.0.0.1
PORT=3000
CODEX_RUNTIME_DIR=.runtime/codex
COST_LOG_PATH=.runtime/gateway-costs.jsonl
# For public HTTPS hosting only; local HTTP needs false.
COOKIE_SECURE=false
# DATABASE_URL overrides APP_DATABASE_URL; leave it unset for native startup.
