# ---------------------------------------------------------------------------
# Maxify Support — local configuration
# Copy to .env. Everything works with the defaults below: the app runs with a
# deterministic demo engine and local pgvector retrieval, no API key required.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

# Postgres + pgvector. Compose publishes 5435; native installs often use 5432.
DATABASE_URL=postgres://support:support@127.0.0.1:5435/support

# Bootstrap on boot: migrate, ingest the corpus, and seed the demo workspace.
# Set AUTO_BOOTSTRAP=false for production deployments.
AUTO_BOOTSTRAP=true
SEED_DEMO=true

# --- Model provider ---------------------------------------------------------
# AGENT_MODE:
#   demo — deterministic engine, no key required (default; safest for demos)
#   live — always call the configured model
#   auto — use the model only when OPENAI_API_KEY is non-empty
# Any OpenAI-compatible endpoint works: OpenAI, Azure OpenAI, LiteLLM, vLLM,
# Ollama, OpenRouter, etc. Set OPENAI_BASE_URL accordingly.
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
# auto: use embeddings when the live model path is active; demo mode stays
# lexical-only. Use "on" to force embeddings or "off" to disable them.
EMBEDDINGS_MODE=auto

# --- Observability ----------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=maxify-support
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_METRICS_HOST=127.0.0.1
OTEL_METRICS_PORT=9464
JAEGER_UI_URL=http://127.0.0.1:16686
LOG_LEVEL=info

# --- Evaluation harness -----------------------------------------------------
# Shared secret for the internal evaluation endpoints and the Python runner.
EVAL_API_TOKEN=local-eval-token-change-me
EVAL_PYTHON=python3

# --- Safety / limits --------------------------------------------------------
MAX_MESSAGE_CHARS=2000
MODEL_TIMEOUT_MS=45000
# Auto-approve return requests at or below this value; larger returns go to a human.
RETURN_AUTO_APPROVE_LIMIT_CENTS=50000
RATE_LIMIT_PER_MINUTE=60
COOKIE_SECURE=false
